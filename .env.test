# Environment for the browser suite (`npm run test:e2e`). Committed on
# purpose: every value here is throwaway, and a suite that needs a file
# somebody has to write by hand is a suite CI cannot run.
#
# **No real secret ever goes in this file.** The keys below were generated
# once, for tests, and protect nothing. The firm's own values live in
# Vercel and in `.env`, which is not committed and which this suite must
# never read — a test run that picked up the live `MONGODB_URI` is exactly
# the accident `tests/e2e/assert-safe-db.mjs` now refuses.
#
# MONGODB_URI is deliberately absent: `scripts/e2e.mjs` starts a throwaway
# replica set and sets it. Putting a URI here would be a second answer to
# the only question that matters.

# **This is a test run, whatever NODE_ENV says.**
#
# The suite serves the app with `next start`, which sets
# NODE_ENV=production on a laptop. Without this the production guards treat
# the server under test as the firm's real deployment and refuse to boot it
# over STORAGE_DRIVER=local — which is correct for Vercel and wrong here.
#
# doctor FAILs if this is ever set on a real deployment, so it cannot hide
# in production the way AUTH_SKIP_2FA did.
PHMG_ENV=test

AUTH_SECRET="n1UMKmC1jX71wfSQ4vcX+cjuIpNIJsykGgEQfsl8U6c="
NEXTAUTH_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"

# 2FA stays ON under test, whatever a developer's .env says: the suite's job
# is to test what goes live. playwright.config.mjs forces this too.
AUTH_SKIP_2FA=false

FIELD_ENCRYPTION_KEY="VqayAsqgvGoX41T6/K6xI39Gd915PmRHSSvgJXG9nWo="

# The local driver writes under .storage/, which the suite is free to fill.
# The gateway driver is exercised separately by scripts/gateway-smoke.mjs.
STORAGE_DRIVER="local"
STORAGE_GATEWAY_URL=""
STORAGE_SHARED_SECRET="3119a0a369dc620772283bbb17b3c9a4888934953230cee1edfc3e9e048ff316"
STORAGE_ENCRYPTION_KEY="wAU+SL1yANWLJU9SoZJFd/gRe6l/RU22tRebPtAomeM="
STORAGE_LOCAL_DIR=".storage-test"
STORAGE_MAX_BYTES="26214400"
STORAGE_RECYCLE_DAYS="90"

DOC_REQUEST_DAYS="7"
DOCUMENT_RETAIN_YEARS="8"

JOBS_SECRET="dadf980b364812817d96859d8873b01a844cf989b7b204a37a4a30a45c0555e0"
JOB_RUNNER_SECONDS="45"
JOB_LEASE_SECONDS="300"

GENERATE_LEAD_DAYS="15"
INTERNAL_TARGET_WORKING_DAYS="3"
TDS_194J_PERCENT="10"
DISCOUNT_APPROVAL_PERCENT="10"
FIRM_BANK_DETAILS=""

# Nothing leaves the machine: the log transport records what would have been
# sent, which is what the mail specs assert against.
EMAIL_TRANSPORT="log"
EMAIL_FROM="notices@phmgindia.test"
EMAIL_ENABLED="true"
EMAIL_CLIENTS_ENABLED="false"
EMAIL_REDIRECT_TO=""
EMAIL_HOURLY_LIMIT="100"

# No Sentry from a test run.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="test"
