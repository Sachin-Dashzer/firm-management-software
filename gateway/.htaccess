# PHMG file gateway (spec section 14).
# Only the three scripts below are reachable; nothing is listed, and no file
# in this folder is ever served as plain content.

Options -Indexes -ExecCGI -MultiViews
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
</IfModule>

# verify.php is a library, not an endpoint
<Files "verify.php">
  Require all denied
</Files>

# force HTTPS: tickets must never travel in the clear
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
