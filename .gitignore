# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which has no secrets in it and must be in the repo
!.env.example
# ...and the browser suite's environment, whose every value is throwaway.
# Committed so CI can run the suite without a file somebody writes by hand.
# It holds no MONGODB_URI: scripts/e2e.mjs supplies a throwaway one.
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env*.local
.env

# the local gateway's config, vault and logs (docker-compose.gateway.yml).
# Holds the shared secret and the encryption key, and the vault holds real
# file bytes — none of it belongs in the repo. docs/GATEWAY_DEPLOY.md has the
# command that creates it.
/.gateway-local/

# test output
/test-results/
/playwright-report/

# local file vault (development storage driver)
.storage/
.taste-skill/
