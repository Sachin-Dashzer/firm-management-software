# PHMG CRM — every environment variable the application reads.
#
# Copy this file to `.env` for your own machine, or paste these into
# Vercel → Settings → Environment Variables for the deployed app
# (docs/DEPLOY.md section 4 walks through both, click by click).
#
# `.env` is never committed. This file is, and it holds no real values.
#
# Only the four under "the minimum" are needed to start the app. Everything
# else has a sensible default or switches a feature off while it is blank.
#
# ---------------------------------------------------------------------------
# The minimum — the app will not run without these
# ---------------------------------------------------------------------------

# MongoDB Atlas, Mumbai (ap-south-1). The database name goes after .net/
# A replica set is required: every change is written with its audit entry in
# one transaction (CLAUDE.md rule 2), and Atlas gives you one by default.
MONGODB_URI=mongodb+srv://phmg-app:PASSWORD@phmg-crm.xxxxx.mongodb.net/phmg?retryWrites=true&w=majority

# Signs the session cookie. Generate with: openssl rand -base64 32
# Changing it signs everybody out, which is harmless.
AUTH_SECRET=

# Where the app is reachable. Used in the links inside emails, so a wrong
# value sends staff and clients to a page that does not exist.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encrypts portal passwords, bank details and Aadhaar (spec §16).
# Generate with: openssl rand -base64 32
#
# *** LOSE THIS AND THAT DATA IS GONE. *** There is no recovery, by design.
# Put it in the firm's password manager AND on paper in the office safe, on
# the day you create it.
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Documents — the PHP file gateway on BigRock (spec §14, DEPLOY.md section 1)
# ---------------------------------------------------------------------------

# "local" keeps files in a folder on this machine, for development.
# "gateway" is the real one. Blank picks local off NODE_ENV.
STORAGE_DRIVER=local

# Where the local driver puts them. Never used in production.
STORAGE_LOCAL_DIR=.storage

# https://files.phmgindia.com/gateway.php — the deployed gateway
STORAGE_GATEWAY_URL=

# Shared with the gateway's own config; signs every upload and download link.
# Generate with: openssl rand -base64 32
STORAGE_SHARED_SECRET=

# Encrypts every client document at rest. The second irreplaceable key —
# the warning on FIELD_ENCRYPTION_KEY applies word for word.
STORAGE_ENCRYPTION_KEY=

# Largest single upload, in bytes. Default 25 MB.
STORAGE_MAX_BYTES=26214400

# How long a deleted document stays in the recycle bin. Default 90.
STORAGE_RECYCLE_DAYS=90

# How long a document is kept before retention lets it go. Default 8 years.
DOCUMENT_RETAIN_YEARS=8

# ---------------------------------------------------------------------------
# Email — the cPanel mailbox, through the job queue only (spec §12)
# ---------------------------------------------------------------------------

# The master switch. false composes and logs messages but sends nothing,
# which is the state to leave it in until the mailbox is ready.
EMAIL_ENABLED=false

# The second switch, for client-facing mail only. Staff mail obeys
# EMAIL_ENABLED; a client never receives anything while this is false.
EMAIL_CLIENTS_ENABLED=false

# While this has an address in it, EVERY message goes there instead of its
# real recipient, with the intended address in the subject. The safe way to
# try the system against real data.
EMAIL_REDIRECT_TO=

EMAIL_FROM="PHMG & Associates <notices@phmgindia.com>"
SMTP_HOST=mail.phmgindia.com
SMTP_PORT=465
SMTP_USER=notices@phmgindia.com
SMTP_PASSWORD=

# Most SMTP hosts cap what one mailbox may send in an hour. Default 100.
EMAIL_HOURLY_LIMIT=100

# "smtp" or "log". Blank sends by SMTP in production and logs elsewhere.
EMAIL_TRANSPORT=

# ---------------------------------------------------------------------------
# The job runner — cPanel cron calls it every five minutes (spec §14)
# ---------------------------------------------------------------------------

# Secret in the cron URL, so only BigRock's cron can start a run.
# Generate with: openssl rand -base64 32
JOBS_SECRET=

# Each run must finish inside a minute. Default 45 seconds of work.
JOB_RUNNER_SECONDS=45

# How long one job may be held before another runner may take it. Default 300.
JOB_LEASE_SECONDS=300

# ---------------------------------------------------------------------------
# Firm rules with a default — change them only on the owner's instruction
# ---------------------------------------------------------------------------

# Working days before a statutory date that the firm aims to be finished.
INTERNAL_TARGET_WORKING_DAYS=3

# A discount above this percentage needs a partner's approval.
DISCOUNT_APPROVAL_PERCENT=10

# TDS under s.194J on a professional fee, in percent. Verify before relying
# on it (CLAUDE.md rule 8).
TDS_194J_PERCENT=10

# Days before a period's due date that recurring work is created.
GENERATE_LEAD_DAYS=15

# Days a document request may sit before it is somebody's problem.
DOC_REQUEST_DAYS=7

# Printed on an invoice under "pay to". Blank leaves it off.
FIRM_BANK_DETAILS=

# ---------------------------------------------------------------------------
# Watching it run (optional, DEPLOY.md section 8)
# ---------------------------------------------------------------------------

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Development only — never set either of these in production
# ---------------------------------------------------------------------------

# true lets a sign-in skip the 2FA code. Spec §16 makes 2FA mandatory for
# staff, so this exists for local work and nothing else.
AUTH_SKIP_2FA=false
