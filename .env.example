# Copy this file to .env.local and fill it in. Never commit .env.local.
# Every variable the app uses is listed here with what it is for.

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string (Mumbai cluster, this app's own user).
# Atlas > Database > Connect > Drivers. Keep the database name at the end.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/phmg?retryWrites=true&w=majority"

# --- Sessions and sign-in -------------------------------------------------
# Signs session cookies and the two-factor sign-in challenge. Any long random
# string; changing it signs everybody out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# The app's own public URL. http://localhost:3000 while developing.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Field encryption (spec section 16) -----------------------------------
# AES-256-GCM key for portal passwords, bank details, Aadhaar and 2FA secrets.
# Exactly 32 bytes, base64-encoded. LOSING THIS MAKES THOSE FIELDS
# UNREADABLE FOREVER — keep a copy in the firm's password manager.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""

# --- File storage (spec sections 6 and 14) --------------------------------
# "bigrock" uses the PHP gateway on the firm's hosting; "local" writes to a
# folder on this machine through the app's own route, for development and
# tests. Left blank, the app picks bigrock when a gateway URL is set.
STORAGE_DRIVER="local"

# The gateway's address, with no trailing slash. Production only.
STORAGE_GATEWAY_URL="https://files.phmgindia.com"

# Signs upload and download tickets. Must match `shared_secret` in the
# gateway's config file on BigRock, exactly.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_SHARED_SECRET=""

# AES-256-GCM key for stored files. Must match `encryption_key` in the
# gateway config. LOSING THIS MAKES EVERY STORED DOCUMENT UNREADABLE FOREVER.
# 32 bytes, base64. Keep a copy in the firm's password manager.
STORAGE_ENCRYPTION_KEY=""

# Where the local driver keeps its vault. Git-ignored.
STORAGE_LOCAL_DIR=".storage"

# Largest file accepted, in bytes. 25 MB by default.
STORAGE_MAX_BYTES="26214400"

# Days a deleted file stays in the recycle bin before it can be erased.
STORAGE_RECYCLE_DAYS="90"

# Days a client upload link stays usable before it expires.
DOC_REQUEST_DAYS="7"

# Years a document is kept (spec section 6: at least eight).
DOCUMENT_RETAIN_YEARS="8"

# --- Background jobs (spec section 14) ------------------------------------
# Lets BigRock's cron start the runner over HTTP, when the hosting plan has
# no Node.js support. Long and random; without it that route is closed.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JOBS_SECRET=""

# Seconds a single runner pass may spend starting new jobs. Shared hosting
# kills long processes, so this stays well under a minute.
JOB_RUNNER_SECONDS="45"

# Seconds a runner holds a job before another run may take it over.
JOB_LEASE_SECONDS="300"

# How many days before a statutory deadline next period's work is created.
GENERATE_LEAD_DAYS="15"

# Working days before the statutory date that the firm aims to finish by.
# This is the internal target on an engagement, never the statutory date.
INTERNAL_TARGET_WORKING_DAYS="3"

# --- Invoicing ------------------------------------------------------------
# Printed in the Payment section at the foot of every invoice PDF. Bank
# name, account number, IFSC and UPI id, as one line or several.
FIRM_BANK_DETAILS=""

# TDS rate the client is expected to deduct on professional fees (194J).
TDS_194J_PERCENT="10"

# A discount above this needs a partner to approve it.
DISCOUNT_APPROVAL_PERCENT="10"

# --- Email (spec sections 12 and 14) --------------------------------------
# "smtp" sends through the firm's cPanel mailbox; "log" writes messages to
# the server log instead, which is what development uses. Left blank, the
# app picks smtp when SMTP_HOST is set.
EMAIL_TRANSPORT="log"

SMTP_HOST="mail.phmgindia.com"
SMTP_PORT="465"
SMTP_USER="notices@phmgindia.com"
SMTP_PASSWORD=""
EMAIL_FROM="PHMG & Associates <notices@phmgindia.com>"

# THE SAFETY SWITCHES. Client email stays off until go-live: messages are
# still composed and logged, and visible in Settings > Messages, but are
# not delivered. Turn this on only when the mailbox, SPF, DKIM and DMARC
# are all set up and the firm is ready for clients to hear from the system.
EMAIL_CLIENTS_ENABLED="false"

# Stops every email, internal ones too.
EMAIL_ENABLED="true"

# Sends everything to this address instead of the real recipient, with the
# intended address in the subject. For testing the real SMTP path without
# touching a client. Leave blank in production.
EMAIL_REDIRECT_TO=""

# Messages an hour, kept under BigRock's cap. Confirm the real limit with
# the host before raising it.
EMAIL_HOURLY_LIMIT="100"
